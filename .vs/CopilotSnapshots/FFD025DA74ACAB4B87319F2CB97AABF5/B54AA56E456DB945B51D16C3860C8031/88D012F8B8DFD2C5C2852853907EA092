namespace Displacement
{
    using System.ComponentModel;
    using System.Text.Json;
    public partial class Main : Form
    {
        private AlertService _alert = new AlertService();
        private readonly BindingList<ActiveAlert> _activeAlerts = new();
        private string SettingsFile => Path.Combine(Application.StartupPath, "setting.json");
        private readonly FmpService _fmpService =  new FmpService("bNwpAsAvIjEKxid7uc5F78XBPmUuW8l2");

        private CancellationTokenSource? _monitoringCts;
        private bool _isMonitoring;

        public Main()
        {
            InitializeComponent();

            dateWatchDateStart.Value = DateTime.Now.AddDays(-5);
            dateWatchDateEnd.Value = DateTime.Now;
            cboTimeFrame.SelectedIndex = 0;
            LoadData();
            SetupAlertGrid();

        }

        private async void btnStart_Click(object sender, EventArgs e)
        {
            SaveDate();

            var tickers = txtTickers.Text.Split(";", StringSplitOptions.RemoveEmptyEntries)
                .Select(t => t.Trim())
                .Distinct()
                .ToList();

            if (!tickers.Any())
                return;

            var timeFrame = cboTimeFrame.SelectedItem?.ToString() ?? "5m";
            var startDate = GetDateString(dateWatchDateStart.Text);
            var endDate = GetDateString(dateWatchDateEnd.Text);

            // Process all tickers concurrently
            var tasks = tickers.Select(ticker => ProcessTickerAsync(ticker, timeFrame, startDate, endDate));
            await Task.WhenAll(tasks);
        }

        private async Task ProcessTickerAsync(string ticker, string timeFrame, string startDate, string endDate)
        {
            try
            {
                var candles = await _fmpService.GetIntradayCandlesAsync(ticker, timeFrame, startDate, endDate);

                if (candles == null || !candles.Any())
                    return;

                var watcher = new DisplacementWatcher(_alert, ticker, timeFrame);
                var result = watcher.DetectDisplacement(candles, 15, 14, 20);

                if (result.IsDisplacement)
                {
                    // Ensure thread-safety when updating UI
                    if (InvokeRequired)
                    {
                        Invoke(() => OnDisplacementDetected(result.Ticker, result.TimeFrame));
                    }
                    else
                    {
                        OnDisplacementDetected(result.Ticker, result.TimeFrame);
                    }
                }
            }
            catch (Exception ex)
            {
                // Log or handle errors per ticker
                System.Diagnostics.Debug.WriteLine($"Error processing {ticker}: {ex.Message}");
            }
        }




        private void SetupAlertGrid()
        {
            gridAlert.AutoGenerateColumns = false;
            gridAlert.DataSource = _activeAlerts;

            gridAlert.Columns.Add(new DataGridViewTextBoxColumn
            {
                HeaderText = "Ticker",
                DataPropertyName = "Ticker"
            });

            gridAlert.Columns.Add(new DataGridViewTextBoxColumn
            {
                HeaderText = "Timeframe",
                DataPropertyName = "TimeFrame"
            });

            gridAlert.Columns.Add(new DataGridViewTextBoxColumn
            {
                HeaderText = "Time",
                DataPropertyName = "AlertTime"
            });

            gridAlert.Columns.Add(new DataGridViewButtonColumn
            {
                HeaderText = "Action",
                Text = "Stop",
                UseColumnTextForButtonValue = true,
                Name = "StopButton"
            });

            gridAlert.CellClick += gridAlert_CellClick;
        }

        private void gridAlert_CellClick(object? sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0)
                return;

            if (gridAlert.Columns[e.ColumnIndex].Name == "StopButton")
            {
                var alert = _activeAlerts[e.RowIndex];

                _activeAlerts.Remove(alert);

                if (_activeAlerts.Count == 0)
                {
                    _alert.StopAlarm();
                }
            }
        }

        private void OnDisplacementDetected(string ticker, string timeframe)
        {
            bool alreadyExists = _activeAlerts.Any(x =>
                x.Ticker == ticker &&
                x.TimeFrame == timeframe);

            if (alreadyExists)
                return;

            _activeAlerts.Add(new ActiveAlert
            {
                Ticker = ticker,
                TimeFrame = timeframe,
                AlertTime = DateTime.Now
            });

            _alert.StartAlarm();
        }

        private void SaveDate()
        {
            var settings = new Data
            {
                Tickers = txtTickers.Text.Split(";", StringSplitOptions.RemoveEmptyEntries)
                .Distinct()
                .ToList(),
                TimeFrame = cboTimeFrame.SelectedItem?.ToString() ?? "5m"
            };

            var json = JsonSerializer.Serialize(settings, new JsonSerializerOptions
            {
                WriteIndented = true
            });

            File.WriteAllText(SettingsFile, json);

        }

        private void LoadData()
        {
            if (!File.Exists(SettingsFile))
                return;

            var json = File.ReadAllText(SettingsFile);

            var settings = JsonSerializer.Deserialize<Data>(json);

            txtTickers.Text = string.Join(";", settings?.Tickers ?? Array.Empty<string>());
            cboTimeFrame.SelectedItem = settings?.TimeFrame ?? "5m";
        }

        private void lblWatchList_Click(object sender, EventArgs e)
        {

        }

        private void Main_Load(object sender, EventArgs e)
        {

        }

        private string GetDateString(string date)
        {
            return DateTime.Parse(date).ToString("yyyy-MM-dd"); 
        }
    }
}
