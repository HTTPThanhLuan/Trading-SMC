        private void AddAlertToGrid(Trading.Smc.v2.SmcAlertSignal signal)
        {
            if (InvokeRequired)
            {
                Invoke(() => AddAlertToGrid(signal));
                return;
            }
            bool alreadyExists = _activeAlerts.Any(x =>
                x.Ticker == signal.Ticker &&
                x.TimeFrame == signal.LowerTimeFrame);
            if (alreadyExists)
                return;
            _activeAlerts.Add(new ActiveAlert
            {
                Ticker = signal.Ticker,
                TimeFrame = signal.LowerTimeFrame,
                // AlertTime = signal.,
                Direction = signal.Direction.ToString()
            });
        }


        private async Task ScanTickerAsync(string ticker, List<Trading.Smc.v2.Candle> candles, CancellationToken cancellationToken = default)
        {
            var setups = new[]
            {
                new { HigherTimeFrame = "4hour", LowerTimeFrames = new[] { "15min", "5min" } },
                new { HigherTimeFrame = "1hour",  LowerTimeFrames = new[] { "15min", "5min" } }
            };

            foreach (var setup in setups)
            {
                var htfResult = await FindHtfZoneRetestAsync(
                    _fmp,
                    ticker,
                    setup.HigherTimeFrame);

                if (!htfResult.IsPriceInZone)
                    continue;

                foreach (var lowerTimeFrame in setup.LowerTimeFrames)
                {
                    var signal = await CheckLtfChochWithDisplacementAsync(
                        _fmp,
                        ticker,
                        setup.HigherTimeFrame,
                        lowerTimeFrame,
                        htfResult.Zone);

                    if (signal.ShouldAlert)
                    {
                        AddAlertToGrid(signal);
                        _alert.StartAlarm();
                        return;
                    }
                }
            }
        }

        public async Task<Trading.Smc.v2.SmcAlertSignal> CheckLtfChochWithDisplacementAsync(
        Trading.Smc.v2.FmpService fmp,
        string ticker,
        string higherTimeFrame,
        string lowerTimeFrame,
        Trading.Smc.v2.PriceZone htfZone)
        {


            var candles = await fmp.GetCandlesAsync(
                ticker,
                lowerTimeFrame,
                100);

            SmcAnalyzer analyzer = new SmcAnalyzer();

            var analysis = analyzer.Analyze(
                candles,
                range: 100,
                swingLength: lowerTimeFrame == "5min" ? 3 : 4);


            bool hasRecentChoch = analysis.StructureBreaks
                .Where(x => x.IsChoch)
                .TakeLast(10)
                .Any(x => x.Direction == htfZone.ExpectedReactionDirection);

            if (!hasRecentChoch)
                return Trading.Smc.v2.SmcAlertSignal.NoAlert(ticker);


            var displacement = SmcAnalyzer.DetectBestDisplacement(candles);


            if (!displacement.IsDisplacement)
                return Trading.Smc.v2.SmcAlertSignal.NoAlert(ticker);

            if (displacement.Direction != htfZone.ExpectedReactionDirection)
                return Trading.Smc.v2.SmcAlertSignal.NoAlert(ticker);


            return new Trading.Smc.v2.SmcAlertSignal
            {
                ShouldAlert = true,
                Ticker = ticker,
                HigherTimeFrame = higherTimeFrame,
                LowerTimeFrame = lowerTimeFrame,
                Direction = htfZone.ExpectedReactionDirection,
                HigherTimeFrameZone = htfZone,
                Message =
                    $"{ticker}: {higherTimeFrame} retraced to {htfZone.Type}, " +
                    $"{lowerTimeFrame} CHOCH + displacement confirmed."
            };
        }

        public async Task<HtfZoneRetestResult> FindHtfZoneRetestAsync(
        Trading.Smc.v2.FmpService fmp,
        string ticker,
        string higherTimeFrame)
        {

            var htfCandles = await fmp.GetCandlesAsync(
                ticker,
                higherTimeFrame,
                150);

            SmcAnalyzer analyzer = new SmcAnalyzer();

            var analysis = analyzer.Analyze(
                htfCandles,
                range: 100,
                swingLength: higherTimeFrame == "4hour" ? 3 : 4);


            var latestCandle = candles[^1];

            var zones = analysis.AllZones
                .Where(z => !z.IsBroken)
                .OrderByDescending(z => z.Score)
                .ToList();

            foreach (var zone in zones)
            {
                if (IsCandleTouchingZone(latestCandle, zone))
                {
                    return new HtfZoneRetestResult
                    {
                        IsPriceInZone = true,
                        Ticker = ticker,
                        HigherTimeFrame = higherTimeFrame,
                        Zone = zone
                    };
                }
            }

            return new HtfZoneRetestResult
            {
                IsPriceInZone = false,
                Ticker = ticker,
                HigherTimeFrame = higherTimeFrame
            };
        }

        public static bool IsCandleTouchingZone(Trading.Smc.v2.Candle candle, Trading.Smc.v2.PriceZone zone)
        {
            return candle.Low <= zone.High && candle.High >= zone.Low;
        }

