
using System.Net.Http.Json;
using System.Text.Json;
using System.Text.Json.Serialization;

namespace Smc;

// ================================================================
// FMP API SERVICE
// ================================================================

public sealed class FmpService : IDisposable
{
    private readonly HttpClient _httpClient;
    private readonly string _apiKey;
    private readonly bool _disposeClient;
    private readonly CandleCacheService _cache = new();
    public FmpService(string apiKey, HttpClient? httpClient = null)
    {
        _apiKey = apiKey ?? throw new ArgumentNullException(nameof(apiKey));
        _httpClient = httpClient ?? new HttpClient { BaseAddress = new Uri("https://financialmodelingprep.com/stable/") , Timeout = TimeSpan.FromSeconds(30) };
        _disposeClient = httpClient == null;
    }

    public async Task<DateTime?> GetLastCandleTime(string ticker, string timeframe)
    {
       return _cache.GetLastCandleTime(ticker, timeframe);
    }

    public async Task<List<Candle>> GetCandlesAsync(
    string ticker,
    string timeframe,
    int candleCount,
    DateTime? lookBackFrom = null,
    CancellationToken cancellationToken = default
    )
    {
        if (!_cache.HasCache(ticker, timeframe))
        {
            var candles = await GetLookbackCandlesAsync(
                ticker,
                timeframe,
                candleCount,lookBackFrom);

            _cache.Set(ticker, timeframe, candles, candleCount);

            return candles;
        }

        var lastTime = _cache.GetLastCandleTime(ticker, timeframe);

        var from = lastTime?.ConvertLocalToEstTime().AddMinutes(-10) ?? DateTime.UtcNow.ConvertEstToLocalTime().AddDays(-5);
        var to = DateTime.Now.ConvertLocalToEstTime();

        var newCandles = await GetCandlesAsync(
            ticker,
            timeframe,
            from,
            to);

        _cache.Merge(ticker, timeframe, newCandles, candleCount);

        return _cache.Get(ticker, timeframe);
    }

    public async Task<List<Candle>> GetCandlesAsync(
       string ticker,
       string timeframe,
       DateTime start,
       DateTime end)
    {
        string from = start.ToString("yyyy-MM-dd");
        string to = end.ToString("yyyy-MM-dd");
      

        string url =$"historical-chart/{timeframe}?symbol={ticker.ToUpper()}&from={from}&to={to}&apikey={_apiKey}";

        var result =
            await _httpClient.GetFromJsonAsync<List<FmpCandleDto>>(url, JsonHandler.JsonOptions);


        return result?
            .Select(x => ToCandle(x))
            .OrderBy(x => x.Time)
            .ToList()
            ?? new List<Candle>();
    }

    private async Task<List<Candle>> GetLookbackCandlesAsync(
    string ticker,
    string timeframe,
    int candleCount,
    DateTime? lookBackFrom = null
        )
    {
        var (start, end) =
            DateRangeCalculate(timeframe, candleCount, lookBackFrom);

        return await GetCandlesAsync(
            ticker,
            timeframe,
            start,
            end);
    }

    private static Candle ToCandle(FmpCandleDto x) => new()
    {
        Time = x.Date,
        Open = x.Open,
        High = x.High,
        Low = x.Low,
        Close = x.Close,
        Volume = x.Volume
    };

    public void Dispose()
    {
        if (_disposeClient) _httpClient.Dispose();
    }

    private sealed class FmpCandleDto
    {
        [JsonPropertyName("date")] public DateTime Date { get; set; }
        [JsonPropertyName("open")] public decimal Open { get; set; }
        [JsonPropertyName("high")] public decimal High { get; set; }
        [JsonPropertyName("low")] public decimal Low { get; set; }
        [JsonPropertyName("close")] public decimal Close { get; set; }
        [JsonPropertyName("volume"), JsonConverter(typeof(SafeInt64Converter))] public long Volume { get; set; }
    }

    /// <summary>
    /// Custom converter that handles volume deserialization safely.
    /// Converts decimal/large numbers to long, or defaults to 0 if value is null or out of bounds.
    /// </summary>
    private sealed class SafeInt64Converter : System.Text.Json.Serialization.JsonConverter<long>
    {
        public override long Read(ref Utf8JsonReader reader, Type typeToConvert, JsonSerializerOptions options)
        {
            switch (reader.TokenType)
            {
                case JsonTokenType.Number:
                    if (reader.TryGetInt64(out long longValue))
                        return longValue;

                    // Try to parse as decimal if it's larger than long.MaxValue or has decimals
                    if (reader.TryGetDecimal(out decimal decimalValue))
                        return (long)decimalValue;

                    return 0;

                case JsonTokenType.String:
                    var stringValue = reader.GetString();
                    if (string.IsNullOrWhiteSpace(stringValue))
                        return 0;

                    if (long.TryParse(stringValue, out var parsedLong))
                        return parsedLong;

                    if (decimal.TryParse(stringValue, out var parsedDecimal))
                        return (long)parsedDecimal;

                    return 0;

                case JsonTokenType.Null:
                    return 0;

                default:
                    return 0;
            }
        }

        public override void Write(Utf8JsonWriter writer, long value, JsonSerializerOptions options)
        {
            writer.WriteNumberValue(value);
        }
    }

    private sealed class FmpDailyResponse
    {
        [JsonPropertyName("symbol")] public string Symbol { get; set; } = string.Empty;
        [JsonPropertyName("historical")] public List<FmpCandleDto> Historical { get; set; } = new();
    }


    private static (DateTime start, DateTime end)
        DateRangeCalculate(string timeframe, int candleCount, DateTime? lookBackFrom = null)
    {
        var span = GetTimeSpan(timeframe);

        var totalDuration = TimeSpan.FromTicks(
            span.Ticks * candleCount);

        // add 30% safety buffer
        totalDuration = TimeSpan.FromTicks(
            (long)(totalDuration.Ticks * 1.3));

        var end = lookBackFrom ?? DateTime.Now.ConvertLocalToEstTime();
        var start =( end - totalDuration).ConvertLocalToEstTime();

        return (start, end);
    }

    private static TimeSpan GetTimeSpan(string timeframe)
    {
        return timeframe.ToLower() switch
        {
            "1min" => TimeSpan.FromMinutes(1),
            "5min" => TimeSpan.FromMinutes(5),
            "15min" => TimeSpan.FromMinutes(15),
            "30min" => TimeSpan.FromMinutes(30),
            "1hour" => TimeSpan.FromHours(1),
            "4hour" => TimeSpan.FromHours(4),
            "daily" => TimeSpan.FromDays(1),
            _ => throw new Exception("Invalid timeframe")
        };
    }

}

