        // ==================== ANALYZE METHOD TESTS ====================

        [TestMethod]
        public void Analyze_InsufficientCandles_ReturnsEmptyResult()
        {
            // Arrange
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>();

            for (int i = 0; i < 10; i++)
            {
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), 100, 101, 99, 100));
            }

            // Act
            var result = SmcAnalyzer.Analyze(candles, range: 100, swingLength: 5);

            // Assert
            Assert.IsNotNull(result);
            Assert.AreEqual(0, result.Swings.Count);
        }

        [TestMethod]
        public void Analyze_ValidCandles_PopulatesAllFields()
        {
            // Arrange
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>();

            // Create 50 candles with up and down pattern
            for (int i = 0; i < 50; i++)
            {
                decimal basePrice = 100 + (i * 0.5m);
                if (i % 3 == 0) basePrice -= 1;  // Create pullback
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), basePrice, basePrice + 2, basePrice - 1, basePrice + 1));
            }

            // Act
            var result = SmcAnalyzer.Analyze(candles, range: 50, swingLength: 2, sourceTimeFrame: "5min");

            // Assert
            Assert.IsNotNull(result);
            Assert.IsTrue(result.Swings.Count > 0, "Should detect swings");
            Assert.AreNotEqual(TrendType.Unknown, result.Trend, "Should detect trend");
        }

        [TestMethod]
        public void Analyze_VariousParameters_ProducesConsistentResults()
        {
            // Arrange
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>();

            for (int i = 0; i < 50; i++)
            {
                decimal price = 100 + (decimal)Math.Sin(i * 0.2) * 10;
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), price, price + 2, price - 2, price + 1));
            }

            // Act
            var result1 = SmcAnalyzer.Analyze(candles, range: 50, swingLength: 2);
            var result2 = SmcAnalyzer.Analyze(candles, range: 50, swingLength: 5);

            // Assert
            Assert.IsNotNull(result1);
            Assert.IsNotNull(result2);
            // More sensitive settings should detect more or equal swings
            Assert.IsTrue(result1.Swings.Count >= result2.Swings.Count);
        }

        // ==================== PATTERN RECOGNITION TESTS ====================

        [TestMethod]
        public void Analyze_StrongUptrend_DetectsSwingsAndBullishTrend()
        {
            // Arrange - strong uptrend
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>();
            decimal basePrice = 100;

            for (int i = 0; i < 40; i++)
            {
                decimal price = basePrice + (i * 0.5m);
                if (i % 4 == 0) price -= 1;  // Small pullback
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), price, price + 1, price - 0.5m, price + 0.5m));
            }

            // Act
            var result = SmcAnalyzer.Analyze(candles, range: 40, swingLength: 2);

            // Assert
            Assert.IsTrue(result.Swings.Count > 0);
            Assert.AreEqual(TrendType.Bullish, result.Trend);
        }

        [TestMethod]
        public void Analyze_StrongDowntrend_DetectsSwingsAndBearishTrend()
        {
            // Arrange - strong downtrend
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>();
            decimal basePrice = 150;

            for (int i = 0; i < 40; i++)
            {
                decimal price = basePrice - (i * 0.5m);
                if (i % 4 == 0) price += 1;  // Small bounce
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), price, price + 0.5m, price - 1, price - 0.5m));
            }

            // Act
            var result = SmcAnalyzer.Analyze(candles, range: 40, swingLength: 2);

            // Assert
            Assert.IsTrue(result.Swings.Count > 0);
            Assert.AreEqual(TrendType.Bearish, result.Trend);
        }

        [TestMethod]
        public void Analyze_FlatMarket_MinimalSwings()
        {
            // Arrange - flat market
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>();

            for (int i = 0; i < 40; i++)
            {
                // Very small range
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), 100, 100.2m, 99.8m, 100));
            }

            // Act
            var result = SmcAnalyzer.Analyze(candles, range: 40, swingLength: 5);

            // Assert
            Assert.IsNotNull(result);
            // Flat market should have few or no swings with larger swing length
        }
