        // ==================== CALCULATE ATR TESTS ====================

        [TestMethod]
        public void CalculateAtr_ValidCandles_ReturnsAtrValues()
        {
            // Arrange
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>();

            // Create candles with varying ranges
            for (int i = 0; i < 20; i++)
            {
                decimal low = 100 + i;
                decimal high = low + 5;
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), low, high, low, low + 2.5m));
            }

            // Act
            var atr = SmcAnalyzer.CalculateAtr(candles, period: 14);

            // Assert
            Assert.AreEqual(14, atr.Count);
            Assert.IsTrue(atr.All(a => a > 0), "All ATR values should be positive");
        }

        [TestMethod]
        public void CalculateAtr_ImplicitPeriod_Uses14Default()
        {
            // Arrange
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>();

            for (int i = 0; i < 20; i++)
            {
                decimal low = 100 + i;
                decimal high = low + 5;
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), low, high, low, low + 2));
            }

            // Act
            var atrDefault = SmcAnalyzer.CalculateAtr(candles);
            var atrExplicit = SmcAnalyzer.CalculateAtr(candles, period: 14);

            // Assert
            Assert.AreEqual(atrDefault.Count, atrExplicit.Count);
            CollectionAssert.AreEqual(atrDefault, atrExplicit);
        }

