        // ==================== HELPER METHODS ====================

        /// <summary>
        /// Creates a candle with the specified OHLCV values
        /// </summary>
        private static Candle CreateCandle(DateTime time, decimal open, decimal high, decimal low, decimal close, long volume = 1000)
        {
            return new Candle
            {
                Time = time,
                Open = open,
                High = high,
                Low = low,
                Close = close,
                Volume = volume
            };
        }

        /// <summary>
        /// Creates a simple bullish candle
        /// </summary>
        private static Candle CreateBullishCandle(DateTime time, decimal low, decimal high)
        {
            return CreateCandle(time, low, high, low, high);
        }

        /// <summary>
        /// Creates a simple bearish candle
        /// </summary>
        private static Candle CreateBearishCandle(DateTime time, decimal high, decimal low)
        {
            return CreateCandle(time, high, low, low, high);
        }

        // ==================== DETECT SWINGS TESTS ====================

        [TestMethod]
        public void DetectSwings_EmptyList_ReturnsEmptyList()
        {
            // Arrange
            var candles = new List<Candle>();

            // Act
            var result = SmcAnalyzer.DetectSwings(candles);

            // Assert
            Assert.AreEqual(0, result.Count);
        }

        [TestMethod]
        public void DetectSwings_InsufficientCandles_ReturnsEmptyList()
        {
            // Arrange - less than swingLength * 2 + 1
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>
            {
                CreateCandle(baseTime, 100, 101, 99, 100),
                CreateCandle(baseTime.AddMinutes(5), 100, 102, 98, 101),
                CreateCandle(baseTime.AddMinutes(10), 101, 103, 97, 102),
            };

            // Act
            var result = SmcAnalyzer.DetectSwings(candles, swingLength: 5);

            // Assert
            Assert.AreEqual(0, result.Count);
        }

        [TestMethod]
        public void DetectSwings_SimpleUpDownPattern_DetectsHighAndLow()
        {
            // Arrange
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>
            {
                CreateCandle(baseTime, 100, 101, 99, 100),
                CreateCandle(baseTime.AddMinutes(5), 100, 100.5m, 99.5m, 100),
                CreateCandle(baseTime.AddMinutes(10), 99, 99.5m, 98, 99),           // Local Low
                CreateCandle(baseTime.AddMinutes(15), 100, 105, 99, 104),          // Local High
                CreateCandle(baseTime.AddMinutes(20), 104, 104.5m, 102, 104),
                CreateCandle(baseTime.AddMinutes(25), 104, 105, 103, 103),
            };

            // Act
            var result = SmcAnalyzer.DetectSwings(candles, swingLength: 2);

            // Assert
            Assert.IsTrue(result.Count >= 2);
            Assert.IsTrue(result.Any(s => s.Type == SwingType.Low));
            Assert.IsTrue(result.Any(s => s.Type == SwingType.High));
        }

        [TestMethod]
        public void DetectSwings_ConsecutiveHighs_RemovesWeaker()
        {
            // Arrange
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>
            {
                CreateCandle(baseTime, 100, 101, 99, 100),
                CreateCandle(baseTime.AddMinutes(5), 100, 100.5m, 99.5m, 100),
                CreateCandle(baseTime.AddMinutes(10), 101, 102, 100, 101),    // Weaker High
                CreateCandle(baseTime.AddMinutes(15), 102, 105, 101, 104),    // Stronger High
                CreateCandle(baseTime.AddMinutes(20), 104, 104.5m, 102, 104),
                CreateCandle(baseTime.AddMinutes(25), 104, 105, 103, 103),
            };

            // Act
            var result = SmcAnalyzer.DetectSwings(candles, swingLength: 2);
            var highs = result.Where(s => s.Type == SwingType.High).ToList();

            // Assert - no consecutive highs
            Assert.IsTrue(highs.Count <= 1 || highs.All(h => h.Level >= 104));
        }

        [TestMethod]
        public void DetectSwings_ConsecutiveLows_RemovesWeaker()
        {
            // Arrange
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>
            {
                CreateCandle(baseTime, 100, 101, 99, 100),
                CreateCandle(baseTime.AddMinutes(5), 100, 101, 99.5m, 100),
                CreateCandle(baseTime.AddMinutes(10), 99, 99.5m, 98.5m, 99),   // Weaker Low
                CreateCandle(baseTime.AddMinutes(15), 98, 98.5m, 96.5m, 97),   // Stronger Low
                CreateCandle(baseTime.AddMinutes(20), 98, 99, 97, 98),
                CreateCandle(baseTime.AddMinutes(25), 98, 100, 97.5m, 99),
            };

            // Act
            var result = SmcAnalyzer.DetectSwings(candles, swingLength: 2);
            var lows = result.Where(s => s.Type == SwingType.Low).ToList();

            // Assert - no consecutive lows
            Assert.IsTrue(lows.Count <= 1 || lows.All(l => l.Level <= 97));
        }

        [TestMethod]
        public void DetectSwings_ReturnsOrderedByIndex()
        {
            // Arrange
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>();

            for (int i = 0; i < 15; i++)
            {
                decimal low = 95 + (i % 4);
                decimal high = low + 8;
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), low + 2, high, low, low + 4));
            }

            // Act
            var result = SmcAnalyzer.DetectSwings(candles, swingLength: 2);

            // Assert
            for (int i = 0; i < result.Count - 1; i++)
            {
                Assert.IsTrue(result[i].Index < result[i + 1].Index);
            }
        }

        [TestMethod]
        public void DetectSwings_AlternatesHighAndLow()
        {
            // Arrange
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>();
            decimal[] prices = { 98, 105, 97, 104, 96, 103 };

            for (int i = 0; i < prices.Length; i++)
            {
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), prices[i], prices[i] + 1, prices[i] - 1, prices[i]));
            }

            // Add buffer
            for (int i = 0; i < 4; i++)
            {
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * (prices.Length + i)), 100, 101, 99, 100));
            }

            // Act
            var result = SmcAnalyzer.DetectSwings(candles, swingLength: 2);

            // Assert
            for (int i = 0; i < result.Count - 1; i++)
            {
                Assert.AreNotEqual(result[i].Type, result[i + 1].Type, $"Swing {i} and {i + 1} should alternate");
            }
        }

