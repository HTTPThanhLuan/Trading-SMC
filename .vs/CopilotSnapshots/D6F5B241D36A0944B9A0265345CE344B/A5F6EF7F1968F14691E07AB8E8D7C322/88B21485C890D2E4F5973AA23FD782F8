/// <summary>
/// Unit tests for SmcAnalyzer.DetectSwings function
/// 
/// The DetectSwings function identifies swing points (local highs and lows) in a candle list
/// using a configurable swing length parameter.
/// 
/// Usage instructions:
/// 1. Add xunit NuGet package to your test project
/// 2. Replace [Fact] with your test framework's test attribute
/// 3. Replace Assert.* calls with your assertion library
/// 4. Update using statements to match your project structure
/// </summary>

using Xunit;
using Trading.Smc.v2;
using System;
using System.Collections.Generic;
using System.Linq;

namespace Displacement.Tests
{
    public class SmcAnalyzerDetectSwingsTests
    {
        private static Candle CreateCandle(DateTime time, decimal open, decimal high, decimal low, decimal close, long volume = 1000)
        {
            return new Candle
            {
                Time = time,
                Open = open,
                High = high,
                Low = low,
                Close = close,
                Volume = volume
            };
        }

        /// <summary>
        /// Test: Empty list returns empty result
        /// Expects: No swings detected
        /// </summary>
        [Fact]
        public void DetectSwings_EmptyList_ReturnsEmptyList()
        {
            var candles = new List<Candle>();
            var result = SmcAnalyzer.DetectSwings(candles);
            Assert.Empty(result);
        }

        /// <summary>
        /// Test: Insufficient candles (fewer than swingLength * 2 + 1)
        /// Expects: Returns empty list (not enough data for swing detection)
        /// </summary>
        [Fact]
        public void DetectSwings_WithInsufficientCandles_ReturnsEmptyList()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 5;
            var candles = new List<Candle>
            {
                CreateCandle(baseTime, 100, 101, 99, 100),
                CreateCandle(baseTime.AddMinutes(5), 100, 102, 98, 101),
                CreateCandle(baseTime.AddMinutes(10), 101, 103, 97, 102),
            };

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);
            Assert.Empty(result);
        }

        /// <summary>
        /// Test: Simple up-down pattern
        /// Pattern: base -> low point -> high point -> recovery
        /// Expects: Both SwingType.Low and SwingType.High detected
        /// </summary>
        [Fact]
        public void DetectSwings_WithSimpleUpDown_DetectsSwingHighAndLow()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 2;
            var candles = new List<Candle>
            {
                CreateCandle(baseTime, 100, 101, 99, 100),
                CreateCandle(baseTime.AddMinutes(5), 100, 100.5m, 99.5m, 100),
                CreateCandle(baseTime.AddMinutes(10), 99, 99.5m, 98, 99),      // Low
                CreateCandle(baseTime.AddMinutes(15), 100, 105, 99, 104),     // High
                CreateCandle(baseTime.AddMinutes(20), 104, 104.5m, 102, 104),
                CreateCandle(baseTime.AddMinutes(25), 104, 105, 103, 103),
            };

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);

            Assert.NotEmpty(result);
            Assert.Count(2, result); // Should detect at least low and high
            Assert.Contains(result, s => s.Type == SwingType.Low);
            Assert.Contains(result, s => s.Type == SwingType.High);
        }

        /// <summary>
        /// Test: Consecutive highs cleanup
        /// Pattern: Creates two consecutive local maxima
        /// Expects: Weaker high removed, only stronger high remains
        /// </summary>
        [Fact]
        public void DetectSwings_WithConsecutiveHighs_RemovesWeakerHigh()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 2;
            var candles = new List<Candle>
            {
                CreateCandle(baseTime, 100, 101, 99, 100),
                CreateCandle(baseTime.AddMinutes(5), 100, 100.5m, 99.5m, 100),
                CreateCandle(baseTime.AddMinutes(10), 101, 102, 100, 101),     // Weaker high
                CreateCandle(baseTime.AddMinutes(15), 102, 105, 101, 104),     // Stronger high
                CreateCandle(baseTime.AddMinutes(20), 104, 104.5m, 102, 104),
                CreateCandle(baseTime.AddMinutes(25), 104, 105, 103, 103),
            };

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);

            var highs = result.Where(s => s.Type == SwingType.High).ToList();
            // Should remove weaker high - no consecutive highs
            Assert.True(highs.Count <= 1 || highs.All(h => h.Level >= 104));
        }

        /// <summary>
        /// Test: Consecutive lows cleanup
        /// Pattern: Creates two consecutive local minima
        /// Expects: Weaker low removed, only stronger low remains
        /// </summary>
        [Fact]
        public void DetectSwings_WithConsecutiveLows_RemovesWeakerLow()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 2;
            var candles = new List<Candle>
            {
                CreateCandle(baseTime, 100, 101, 99, 100),
                CreateCandle(baseTime.AddMinutes(5), 100, 101, 99.5m, 100),
                CreateCandle(baseTime.AddMinutes(10), 99, 99.5m, 98.5m, 99),   // Weaker low
                CreateCandle(baseTime.AddMinutes(15), 98, 98.5m, 96.5m, 97),   // Stronger low
                CreateCandle(baseTime.AddMinutes(20), 98, 99, 97, 98),
                CreateCandle(baseTime.AddMinutes(25), 98, 100, 97.5m, 99),
            };

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);

            var lows = result.Where(s => s.Type == SwingType.Low).ToList();
            // Should remove weaker low - no consecutive lows
            Assert.True(lows.Count <= 1 || lows.All(l => l.Level <= 97));
        }

        /// <summary>
        /// Test: Swings are ordered by index
        /// Expects: All swings in ascending order by their candle index
        /// </summary>
        [Fact]
        public void DetectSwings_ReturnsOrderedByIndex()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 2;
            var candles = new List<Candle>();

            for (int i = 0; i < 15; i++)
            {
                decimal low = 95 + (i % 4);
                decimal high = low + 8;
                decimal close = low + 4;
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), low + 2, high, low, close));
            }

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);

            for (int i = 0; i < result.Count - 1; i++)
            {
                Assert.True(result[i].Index < result[i + 1].Index);
            }
        }

        /// <summary>
        /// Test: All swing properties are properly set
        /// Expects: Time, Index, Type, and Level all have valid values
        /// </summary>
        [Fact]
        public void DetectSwings_SetsCorrectSwingProperties()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 2;
            var candles = new List<Candle>
            {
                CreateCandle(baseTime, 100, 101, 99, 100),
                CreateCandle(baseTime.AddMinutes(5), 100, 100.5m, 99.5m, 100),
                CreateCandle(baseTime.AddMinutes(10), 99, 99.5m, 98, 99),
                CreateCandle(baseTime.AddMinutes(15), 100, 105, 99, 104),
                CreateCandle(baseTime.AddMinutes(20), 104, 104.5m, 102, 104),
                CreateCandle(baseTime.AddMinutes(25), 104, 105, 103, 103),
            };

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);

            foreach (var swing in result)
            {
                Assert.NotNull(swing);
                Assert.True(swing.Index >= 0);
                Assert.True(swing.Level > 0);
                Assert.True(swing.Type == SwingType.High || swing.Type == SwingType.Low);
            }
        }

        /// <summary>
        /// Test: High/Low alternation
        /// Pattern: Creates a zigzag pattern
        /// Expects: No two consecutive swings have same type
        /// </summary>
        [Fact]
        public void DetectSwings_AlternatesHighLow()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 2;
            var candles = new List<Candle>();

            decimal[] prices = { 98, 105, 97, 104, 96, 103 };
            for (int i = 0; i < prices.Length; i++)
            {
                decimal price = prices[i];
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), price, price + 1, price - 1, price));
            }

            // Add buffer candles
            for (int i = prices.Length; i < prices.Length + 4; i++)
            {
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), 100, 101, 99, 100));
            }

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);

            for (int i = 0; i < result.Count - 1; i++)
            {
                Assert.NotEqual(result[i].Type, result[i + 1].Type);
            }
        }

        /// <summary>
        /// Test: Different swing lengths produce different sensitivities
        /// Pattern: Sine wave pattern
        /// Expects: Longer swing length detects fewer/equal swings (less sensitive)
        /// </summary>
        [Fact]
        public void DetectSwings_WithDifferentSwingLengths_ProducesExpectedResults()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var candles = new List<Candle>();

            for (int i = 0; i < 50; i++)
            {
                decimal price = 100 + (decimal)Math.Sin(i * 0.2) * 10;
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), price, price + 2, price - 2, price));
            }

            var result2 = SmcAnalyzer.DetectSwings(candles, 2);
            var result5 = SmcAnalyzer.DetectSwings(candles, 5);
            var result10 = SmcAnalyzer.DetectSwings(candles, 10);

            // Longer swing length = less sensitive = fewer swings
            Assert.True(result2.Count >= result5.Count);
            Assert.True(result5.Count >= result10.Count);
        }

        /// <summary>
        /// Test: Flat price action
        /// Pattern: All candles have same OHLC
        /// Expects: No swings (no extremes to detect)
        /// </summary>
        [Fact]
        public void DetectSwings_WithFlatPrice_ReturnsNoSwings()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 5;
            var candles = new List<Candle>();

            for (int i = 0; i < 20; i++)
            {
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), 100, 100, 100, 100));
            }

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);
            Assert.Empty(result);
        }

        /// <summary>
        /// Test: Strong uptrend with pullbacks
        /// Pattern: Prices increase with periodic pullbacks
        /// Expects: Still detects swings even in trending market
        /// </summary>
        [Fact]
        public void DetectSwings_WithStrongTrend_DetectsSwingsAlongTrend()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 2;
            var candles = new List<Candle>();

            decimal basePrice = 100;
            for (int i = 0; i < 25; i++)
            {
                decimal price = basePrice + (i * 0.5m);
                if (i % 3 == 0) price -= 1; // Small pullback
                candles.Add(CreateCandle(baseTime.AddMinutes(5 * i), price, price + 1, price - 0.5m, price));
            }

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);

            Assert.NotEmpty(result);
            Assert.Contains(result, s => s.Type == SwingType.High);
        }

        /// <summary>
        /// Test: Null list handling
        /// Expects: Throws ArgumentNullException
        /// </summary>
        [Fact]
        public void DetectSwings_WithNullList_ThrowsArgumentNullException()
        {
            List<Candle> candles = null;
            Assert.Throws<ArgumentNullException>(() => SmcAnalyzer.DetectSwings(candles));
        }

        /// <summary>
        /// Test: Peak detection
        /// Pattern: Single peak surrounded by lower candles
        /// Expects: Peak is detected as SwingType.High
        /// </summary>
        [Fact]
        public void DetectSwings_DetectsHighAtPeakCandle()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 1;
            var peak = 110m;
            var candles = new List<Candle>
            {
                CreateCandle(baseTime.AddMinutes(-5), 100, 100, 100, 100),
                CreateCandle(baseTime, peak, peak + 1, peak - 1, peak),       // Peak at index 1
                CreateCandle(baseTime.AddMinutes(5), 100, 100, 100, 100),
            };

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);

            var high = result.FirstOrDefault(s => s.Type == SwingType.High);
            Assert.NotNull(high);
            Assert.Equal(peak, high.Level);
        }

        /// <summary>
        /// Test: Valley detection
        /// Pattern: Single valley surrounded by higher candles
        /// Expects: Valley is detected as SwingType.Low
        /// </summary>
        [Fact]
        public void DetectSwings_DetectsLowAtValleyCandle()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 1;
            var valley = 90m;
            var candles = new List<Candle>
            {
                CreateCandle(baseTime.AddMinutes(-5), 100, 100, 100, 100),
                CreateCandle(baseTime, valley, valley + 1, valley, valley),    // Valley at index 1
                CreateCandle(baseTime.AddMinutes(5), 100, 100, 100, 100),
            };

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);

            var low = result.FirstOrDefault(s => s.Type == SwingType.Low);
            Assert.NotNull(low);
            Assert.Equal(valley, low.Level);
        }

        /// <summary>
        /// Test: Multiple swings in sequence
        /// Pattern: Extended zigzag with alternating peaks and valleys
        /// Expects: Multiple swings detected, alternating between high and low
        /// </summary>
        [Fact]
        public void DetectSwings_WithExtendedZigzag_DetectsMultipleSwings()
        {
            var baseTime = new DateTime(2024, 1, 1, 9, 0, 0);
            var swingLength = 2;
            var candles = new List<Candle>();

            // Create extended zigzag pattern
            decimal[] levels = { 100, 95, 105, 98, 108, 101, 110, 102 };
            foreach (var level in levels)
            {
                candles.Add(CreateCandle(baseTime.AddMinutes(candles.Count * 5), level, level + 1, level - 1, level));
            }

            var result = SmcAnalyzer.DetectSwings(candles, swingLength);

            // Should detect multiple swings
            var highs = result.Where(s => s.Type == SwingType.High).Count();
            var lows = result.Where(s => s.Type == SwingType.Low).Count();

            Assert.True(highs > 0 && lows > 0);
            // High and low counts should be equal or differ by 1 (due to alternation)
            Assert.True(Math.Abs(highs - lows) <= 1);
        }
    }
}
