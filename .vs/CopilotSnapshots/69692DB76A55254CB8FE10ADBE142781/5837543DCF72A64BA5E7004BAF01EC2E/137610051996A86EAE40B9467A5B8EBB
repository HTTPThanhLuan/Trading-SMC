        private async void btnStart_Click(object sender, EventArgs e)
        {


            if (_isMonitoring)
            {
                btnStart.Text = "Start";
                // Stop monitoring
                StopMonitoring();
                return;
            }

            SaveDate();

            var tickers = txtTickers.Text.Split(";", StringSplitOptions.RemoveEmptyEntries)
                .Select(t => t.Trim())
                .Distinct()
                .ToList();

            if (!tickers.Any())
                return;

            var timeFrame = cboTimeFrame.SelectedItem?.ToString() ?? "5min";
            var startDate = GetDateString(dateWatchDateStart.Text);
            var endDate = GetDateString(dateWatchDateEnd.Text);
            var speed = cboSpeed.SelectedItem?.ToString() ?? "1x";
            var candlePeriod = (int)numCandles.Value;
            var atrMultiplier = numATR.Value;

            _isMonitoring = true;
            btnStart.Text = "Stop";
            _monitoringCts = new CancellationTokenSource();


            // await ProcessTickerAsync("EURUSD", "5min", startDate, endDate);
            // Fire and forget - don't await so the click handler returns immediately
            _ = RunMonitoringLoopAsync(tickers, candlePeriod, speed, timeFrame, startDate, endDate, _monitoringCts.Token, atrMultiplier);
        }

        private async Task RunMonitoringLoopAsync(
            List<string> tickers
            , int candlePeriod
            , string speed
            , string timeFrame
            , string startDate
            , string endDate
            , CancellationToken cancellationToken
            , decimal atrMultiplier
            )
        {
            int intervalMs = GetIntervalMs(speed);
            int index = 15;

            while (!cancellationToken.IsCancellationRequested)
            {
                try
                {
                    // Process all tickers concurrently
                    var tasks = tickers.Select(ticker => ProcessTickerAsync(ticker, index, candlePeriod, timeFrame, startDate, endDate, atrMultiplier));
                    await Task.WhenAll(tasks);

                    if (index == candles.Count - 1)
                    {
                        // Stop monitoring if we've reached the end of the candle list
                        StopMonitoring();
                        break;
                    }

                    index++;
                    // Wait for the specified interval
                    await Task.Delay(intervalMs, cancellationToken);
                }
                catch (OperationCanceledException)
                {
                    // Monitoring was cancelled
                    break;
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"Error in monitoring loop: {ex.Message}");
                }
            }
        }

        private int GetIntervalMs(string speed)
        {
            return speed switch
            {
                "1x" => 1000,
                "2x" => 500,
                "5x" => 200,
                "10x" => 100,
                _ => 1000, // Default to 1x if unknown
            };
        }

        private void StopMonitoring()
        {
            _isMonitoring = false;
            _monitoringCts?.Cancel();
            _monitoringCts?.Dispose();
            _monitoringCts = null;
            candles.Clear();
            btnStart.Text = "Start";
        }

        private async Task ProcessTickerAsync(string ticker, int index, int candlePeriod, string timeFrame, string startDate, string endDate, decimal atrMultiplier)
        {
            try
            {
                if (chkIsBacktesting.Checked && candles.Count == 0)
                {
                    candles = await _fmpService.GetIntradayCandlesAsync(ticker, timeFrame, startDate, endDate);
                    candles = candles.OrderBy(c => c.Date).ToList(); // Ensure candles are sorted by DateTime
                }

                if (candles == null || !candles.Any())
                    return;

                var watcher = new DisplacementWatcher(_alert, ticker, timeFrame);
                var result = watcher.DetectDisplacement(candles, index, candlePeriod, atrMultiplier);

                if (result.IsDisplacement)
                {
                    // Ensure thread-safety when updating UI
                    if (InvokeRequired)
                    {
                        Invoke(() => OnDisplacementDetected(result.Ticker, result.TimeFrame, result.DateTime, result.Direction));
                    }
                    else
                    {
                        OnDisplacementDetected(result.Ticker, result.TimeFrame, result.DateTime, result.Direction);
                    }
                }
            }
            catch (Exception ex)
            {
                // Log or handle errors per ticker
                System.Diagnostics.Debug.WriteLine($"Error processing {ticker}: {ex.Message}");
            }
        }

        private void SetupAlertGrid()
