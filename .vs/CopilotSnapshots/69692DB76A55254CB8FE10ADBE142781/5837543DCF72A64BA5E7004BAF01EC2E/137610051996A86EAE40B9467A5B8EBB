        private CancellationTokenSource? _monitoringCts;
        private bool _isMonitoring;
        private List<Candle> candles = new List<Candle>();

        public Main()
        {
            InitializeComponent();

            dateWatchDateStart.Value = new DateTime(2026, 6, 7);
